# =============================================================
# Infimit Backend — environment template
# Copy to `.env` and fill in values for local dev.
# Never commit `.env`.
# =============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
SERVICE_NAME=infimit-backend

# ---- CORS ----
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/infimit
MONGO_MAX_POOL_SIZE=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=infimit:

# ---- JWT (RS256 asymmetric — Subphase 2 onward) ----
# These are PATHS to PEM key files, not the keys themselves.
# Run `npx tsx scripts/generate-keys.ts` once after `npm install` to create them.
# The `keys/` directory is gitignored. In production, mount keys from a secrets
# manager at the same paths.
JWT_ACCESS_PRIVATE_KEY_PATH=./keys/access-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access-public.pem
JWT_REFRESH_PRIVATE_KEY_PATH=./keys/refresh-private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=./keys/refresh-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- AI Service (consumed from Subphase 4 onward) ----
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=replace-me-internal-key
AI_REQUEST_TIMEOUT_MS=2000

# ---- S3 / Object Storage (used from Subphase 3 onward) ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=infimit-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ---- Rate limiting ----
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300

# ---- Observability (Subphase 5+) ----
SENTRY_DSN=
