# Frontend environment template. Copy to .env and edit for local overrides.
# Never commit a real .env — it's gitignored.

# Set to 'true' to use MSW mocks in dev; 'false' to call the live backend.
# Default for `npm run dev` is mock-on so the UI is fully usable without backend.
VITE_USE_MOCK=true

# Backend base URL. Used only when VITE_USE_MOCK=false. Includes the /v1 prefix.
VITE_API_BASE_URL=http://localhost:4000/v1
